# DoshKa Server Configuration
# Скопіюйте цей файл як .env та налаштуйте значення

# Секретний ключ для JWT (згенеруйте новий для продакшену!)
SECRET_KEY=your-super-secret-key-change-in-production-please

# База даних
DATABASE_URL=sqlite+aiosqlite:///./doshka.db

# JWT налаштування
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON масив)
CORS_ORIGINS=["*"]

# Режим розробки
DEBUG=true
